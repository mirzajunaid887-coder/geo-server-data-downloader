{
  "name": "vite-plugin-ssg-spa",
  "version": "1.4.9",
  "description": "A Vite plugin for automatic Static Site Generation (SSG) with SPA fallback support for React applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vite --external puppeteer --external playwright --external happy-dom",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vite",
    "plugin",
    "ssg",
    "static-site-generation",
    "spa",
    "react",
    "prerender",
    "ssr",
    "server-side-rendering"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "happy-dom": "^20.0.10",
    "puppeteer": "^24.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3",
    "vite": "^5.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
